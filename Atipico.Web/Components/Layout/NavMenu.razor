<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand atipico-brand" href="">
            <svg width="20" height="20" viewBox="0 0 24 24" class="atipico-logo" aria-hidden="true">
                <polygon points="12,1 22,7 22,17 12,23 2,17 2,7" fill="none" stroke="currentColor" stroke-width="1.5" />
            </svg>
            ATIPICO
        </a>
    </div>
</div>

@* El hamburger que colapsaba este menu se fue con el rediseño movil: debajo de 641px
   el sidebar entero no se dibuja (MainLayout) y navega BarraInferior. Arriba de 641px
   el menu siempre estuvo abierto. No quedaba ancho en el que el toggler se mostrara,
   y su onclick apuntaba a un elemento que ya nadie ve. *@
<div class="nav-scrollable">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                Panel
            </NavLink>
        </div>

        @* Las secciones salen de Navegacion.Secciones, la misma fuente que usa la hoja
           "Mas" de la barra inferior en movil. El titulo se muestra segun la union de
           los roles de sus links, asi que ya no puede quedar un encabezado sin nada
           debajo (le pasaba a Cocinero con "Pedidos"). *@
        @foreach (var seccion in Navegacion.Secciones)
        {
            <AuthorizeView Roles="@seccion.RolesCsv" Context="seccionAuth">
                <Authorized>
                    <div class="nav-item px-3 nav-section">@seccion.Titulo</div>
                    @foreach (var enlace in seccion.Enlaces)
                    {
                        <AuthorizeView Roles="@string.Join(",", enlace.Roles)" Context="enlaceAuth">
                            <Authorized>
                                <div class="nav-item px-3">
                                    <NavLink class="nav-link" href="@enlace.Url">@enlace.Texto</NavLink>
                                </div>
                            </Authorized>
                        </AuthorizeView>
                    }
                </Authorized>
            </AuthorizeView>
        }
    </nav>

    <AuthorizeView>
        <Authorized>
            <div class="nav-user">
                <div class="nav-user-name">@context.User.FindFirst("nombre")?.Value</div>
                <div class="nav-user-role">@context.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</div>
                <form method="post" action="/auth/logout">
                    <button type="submit" class="btn btn-sm btn-outline-light w-100 mt-2">Cerrar sesión</button>
                </form>
            </div>
        </Authorized>
    </AuthorizeView>
</div>
