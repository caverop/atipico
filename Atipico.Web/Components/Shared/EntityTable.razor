@typeparam TEntity where TEntity : class, IEntity
@inject IJSRuntime JS

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">@Title</h3>
    <AuthorizeView Roles="@RolesCsv">
        <Authorized><a class="btn btn-primary" href="@CreateUrl">+ Nuevo</a></Authorized>
    </AuthorizeView>
</div>

@if (Items is null)
{
    <p><em>Cargando...</em></p>
}
else if (Items.Count == 0)
{
    <p class="text-muted"><em>No hay registros todavía.</em></p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    @foreach (var col in Columns)
                    {
                        <th>@col.Header</th>
                    }
                    <AuthorizeView Roles="@RolesCsv" Context="headerAuth">
                        <Authorized><th></th></Authorized>
                    </AuthorizeView>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Items)
                {
                    <tr>
                        @foreach (var col in Columns)
                        {
                            <td>@col.Value(item)</td>
                        }
                        <AuthorizeView Roles="@RolesCsv" Context="rowAuth">
                            <Authorized>
                                <td class="text-end">
                                    <a class="btn btn-sm btn-outline-secondary" href="@($"{EditUrlPrefix}/{item.Id}")">Editar</a>
                                    @if (ShowDelete)
                                    {
                                        <button type="button" class="btn btn-sm btn-danger" @onclick="() => HandleDelete(item.Id)">@DeleteLabel</button>
                                    }
                                </td>
                            </Authorized>
                        </AuthorizeView>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter, EditorRequired] public List<TEntity>? Items { get; set; }
    [Parameter, EditorRequired] public List<(string Header, Func<TEntity, object?> Value)> Columns { get; set; } = [];
    [Parameter, EditorRequired] public string CreateUrl { get; set; } = "";
    [Parameter, EditorRequired] public string EditUrlPrefix { get; set; } = "";
    // No existe un borrado real (app_restaurante no tiene GRANT DELETE, ver CLAUDE.md): este
    // boton siempre dispara un cambio de estado ("Anular", "Desactivar", etc.), definido por
    // cada pantalla via OnDelete. El texto lo decide el llamador porque el verbo correcto
    // depende de la entidad (Activo=false, Estado=Inactiva/Anulado/Anulada, ...).
    [Parameter] public EventCallback<long> OnDelete { get; set; }
    [Parameter] public string DeleteLabel { get; set; } = "Eliminar";

    // Algunas pantallas (p.ej. Pedidos) sacan esta accion de la grilla a proposito: solo se
    // puede anular entrando a editar el registro, no desde la lista.
    [Parameter] public bool ShowDelete { get; set; } = true;

    // Roles que pueden crear/editar/eliminar en esta pantalla. La API vuelve a
    // validar esto por acción (Create/Update/Delete pueden diferir); esto solo
    // decide qué botones se muestran.
    [Parameter] public string[] WriteRoles { get; set; } = ["Admin"];

    private string RolesCsv => string.Join(",", WriteRoles);

    private async Task HandleDelete(long id)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"¿{DeleteLabel} el registro #{id}?");
        if (confirmed)
        {
            await OnDelete.InvokeAsync(id);
        }
    }
}
