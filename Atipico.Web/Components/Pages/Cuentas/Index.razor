@page "/cuentas"
@attribute [Authorize]
@inject IEntityApiClient<Cuenta> Api
@inject IEntityApiClient<Usuario> UsuarioApi
@inject IJSRuntime JS

<PageTitle>Cuentas</PageTitle>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}

<EntityTable TEntity="Cuenta"
             Title="Cuentas"
             Items="_cuentas"
             Columns="_columns"
             CreateUrl="/cuentas/nuevo"
             EditUrlPrefix="/cuentas"
             OnDelete="HandleDelete"
             DeleteLabel="Anular"
             WriteRoles="@(["Admin", "Mesero", "Cajero"])" />

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private string? _error;
    private List<Cuenta>? _cuentas;
    private Dictionary<long, string> _usuarioNombres = [];
    private List<(string Header, Func<Cuenta, object?> Value)> _columns = [];

    protected override async Task OnInitializedAsync()
    {
        var usuarios = await UsuarioApi.GetAllAsync();
        _usuarioNombres = usuarios.ToDictionary(u => u.Id, u => u.Nombre);

        _columns =
        [
            ("Id", c => c.Id),
            ("Comensal", c => c.Comensal),
            ("Estado", c => c.Estado),
            ("Monto", c => c.Monto.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("es-BO"))),
            ("Método de pago", c => c.MetodoPago?.ToString() ?? "-"),
            ("Mesero", c => _usuarioNombres.GetValueOrDefault(c.IdMesero, $"#{c.IdMesero}")),
            ("Cajero", c => c.IdCajero is null ? "-" : _usuarioNombres.GetValueOrDefault(c.IdCajero.Value, $"#{c.IdCajero}")),
        ];

        _cuentas = await Api.GetAllAsync();
    }

    // No hay borrado real (app_restaurante no tiene GRANT DELETE): "Anular" pone
    // Estado=Anulada. fn_cuenta_inmutable (trigger) solo admite esta transicion desde
    // Abierta o Pagada, y ck_cuenta_anulacion exige responsable y motivo.
    private async Task HandleDelete(long id)
    {
        var cuenta = _cuentas?.FirstOrDefault(c => c.Id == id);
        if (cuenta is null) return;

        var motivo = await JS.InvokeAsync<string?>("prompt", "Motivo para anular la cuenta:");
        if (string.IsNullOrWhiteSpace(motivo)) return;

        try
        {
            cuenta.Estado = EstadoCuenta.Anulada;
            cuenta.IdAnuladoPor = await CurrentUsuarioIdAsync();
            cuenta.MotivoAnulacion = motivo;

            await Api.UpdateAsync(cuenta);
            _cuentas = await Api.GetAllAsync();
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        catch (HttpRequestException)
        {
            _error = "No se pudo conectar con el servidor.";
        }
    }

    private async Task<long?> CurrentUsuarioIdAsync()
    {
        if (AuthStateTask is null) return null;

        var authState = await AuthStateTask;
        var claim = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        return long.TryParse(claim, out var id) ? id : null;
    }
}
