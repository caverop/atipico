@page "/"
@attribute [Authorize]
@inject IEntityApiClient<Usuario> UsuarioApi
@inject IEntityApiClient<TipoPlato> TipoPlatoApi
@inject IEntityApiClient<Plato> PlatoApi
@inject IEntityApiClient<Mesa> MesaApi
@inject IEntityApiClient<Pedido> PedidoApi
@inject IEntityApiClient<PedidoMesa> PedidoMesaApi
@inject IEntityApiClient<PedidoPlato> PedidoPlatoApi
@inject IEntityApiClient<Cuenta> CuentaApi
@inject IEntityApiClient<DetalleCuenta> DetalleCuentaApi

<PageTitle>Panel - Atipico</PageTitle>

<h1 class="mb-1">ATIPICO</h1>
<p class="text-muted mb-4">Panel administrativo. Los datos se leen y se guardan en vivo contra Atipico.Api.</p>

@if (_error is not null)
{
    <div class="alert alert-danger">
        No se pudo conectar con la API (@_error). Confirmá que Atipico.Api esté corriendo.
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var card in _cards)
        {
            <AuthorizeView Roles="@string.Join(",", card.Roles)" Context="cardAuth">
                <Authorized>
                    <div class="col-12 col-sm-6 col-lg-4">
                        <a href="@card.Url" class="text-decoration-none">
                            <div class="p-3 h-100 dashboard-card">
                                <div class="d-flex justify-content-between align-items-start">
                                    <h4 class="mb-0">@card.Title</h4>
                                    <span class="badge">@card.Count</span>
                                </div>
                                <p class="text-muted mb-0 mt-2">@card.Description</p>
                            </div>
                        </a>
                    </div>
                </Authorized>
            </AuthorizeView>
        }
    </div>
}

@code {
    private record Card(string Title, string Description, string Url, int Count, string[] Roles);

    private static readonly string[] AdminOnly = ["Admin"];
    private static readonly string[] AdminMesero = ["Admin", "Mesero"];
    private static readonly string[] AdminCajero = ["Admin", "Cajero"];

    private List<Card> _cards = [];
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var usuarios = await UsuarioApi.GetAllAsync();
            var tipos = await TipoPlatoApi.GetAllAsync();
            var platos = await PlatoApi.GetAllAsync();
            var mesas = await MesaApi.GetAllAsync();
            var pedidos = await PedidoApi.GetAllAsync();
            var pedidoMesas = await PedidoMesaApi.GetAllAsync();
            var pedidoPlatos = await PedidoPlatoApi.GetAllAsync();
            var cuentas = await CuentaApi.GetAllAsync();
            var detalles = await DetalleCuentaApi.GetAllAsync();

            _cards =
            [
                new("Usuarios", "Meseros, cajeros, cocineros y administradores.", "/usuarios", usuarios.Count, AdminOnly),
                new("Tipos de plato", "Categorías de la carta.", "/tipos-plato", tipos.Count, AdminOnly),
                new("Platos", "Platos disponibles y sus precios.", "/platos", platos.Count, AdminOnly),
                new("Mesas", "Mesas del salón.", "/mesas", mesas.Count, AdminOnly),
                new("Pedidos", "Pedidos abiertos, servidos o cerrados.", "/pedidos", pedidos.Count, AdminMesero),
                new("Pedido - Mesa", "Qué mesa ocupa cada pedido.", "/pedido-mesas", pedidoMesas.Count, AdminOnly),
                new("Pedido - Plato", "Platos servidos en cada pedido.", "/pedido-platos", pedidoPlatos.Count, AdminOnly),
                new("Cuentas", "Cuentas abiertas, pagadas o anuladas.", "/cuentas", cuentas.Count, AdminCajero),
                new("Detalle de cuentas", "Líneas facturadas por cuenta.", "/detalle-cuentas", detalles.Count, AdminCajero),
            ];
        }
        catch (HttpRequestException ex)
        {
            _error = ex.Message;
        }
    }
}
