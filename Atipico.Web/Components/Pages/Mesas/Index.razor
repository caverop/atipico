@page "/mesas"
@attribute [Authorize]
@inject IEntityApiClient<Mesa> Api

<PageTitle>Mesas</PageTitle>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}

<EntityTable TEntity="Mesa"
             Title="Mesas"
             Items="_mesas"
             Columns="_columns"
             CreateUrl="/mesas/nuevo"
             EditUrlPrefix="/mesas"
             OnDelete="HandleDelete"
             DeleteLabel="Inactivar"
             WriteRoles="@(["Admin"])" />

@code {
    private string? _error;
    private List<Mesa>? _mesas;

    private readonly List<(string Header, Func<Mesa, object?> Value)> _columns =
    [
        ("Id", m => m.Id),
        ("Número", m => m.Numero),
        ("Capacidad", m => m.Capacidad),
        ("Estado", m => m.Estado),
    ];

    protected override async Task OnInitializedAsync()
    {
        _mesas = await Api.GetAllAsync();
    }

    // No hay borrado real (app_restaurante no tiene GRANT DELETE): "Inactivar"
    // pone Estado=Inactiva, el mismo valor que ya ofrece el selector del formulario de edición.
    private async Task HandleDelete(long id)
    {
        var mesa = _mesas?.FirstOrDefault(m => m.Id == id);
        if (mesa is null) return;

        try
        {
            mesa.Estado = EstadoMesa.Inactiva;
            await Api.UpdateAsync(mesa);
            _mesas = await Api.GetAllAsync();
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        catch (HttpRequestException)
        {
            _error = "No se pudo conectar con el servidor.";
        }
    }
}
