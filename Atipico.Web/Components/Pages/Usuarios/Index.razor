@page "/usuarios"
@attribute [Authorize]
@inject IEntityApiClient<Usuario> Api

<PageTitle>Usuarios</PageTitle>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}

<EntityTable TEntity="Usuario"
             Title="Usuarios"
             Items="_usuarios"
             Columns="_columns"
             CreateUrl="/usuarios/nuevo"
             EditUrlPrefix="/usuarios"
             OnDelete="HandleDelete"
             DeleteLabel="Desactivar"
             WriteRoles="@(["Admin"])" />

@code {
    private string? _error;
    private List<Usuario>? _usuarios;

    private readonly List<(string Header, Func<Usuario, object?> Value)> _columns =
    [
        ("Id", u => u.Id),
        ("Nombre", u => u.Nombre),
        ("Usuario", u => u.NombreUsuario),
        ("Rol", u => u.Rol),
        ("Activo", u => u.Activo ? "Sí" : "No"),
    ];

    protected override async Task OnInitializedAsync()
    {
        _usuarios = await Api.GetAllAsync();
    }

    // No hay borrado real (app_restaurante no tiene GRANT DELETE): "Desactivar"
    // pone Activo=false, lo mismo que ya permite el checkbox del formulario de edición.
    private async Task HandleDelete(long id)
    {
        var usuario = _usuarios?.FirstOrDefault(u => u.Id == id);
        if (usuario is null) return;

        try
        {
            usuario.Activo = false;
            await Api.UpdateAsync(usuario);
            _usuarios = await Api.GetAllAsync();
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        catch (HttpRequestException)
        {
            _error = "No se pudo conectar con el servidor.";
        }
    }
}
