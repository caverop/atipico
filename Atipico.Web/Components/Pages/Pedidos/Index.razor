@page "/pedidos"
@using Atipico.Application.Common
@using Atipico.Application.Models
@attribute [Authorize]
@inject ITurnoApiClient TurnoApi
@inject IEntityApiClient<Usuario> UsuarioApi
@inject EstadoOperaciones Operaciones
@inject IJSRuntime JS

<PageTitle>Pedidos</PageTitle>

@* --- Encabezado de turno ---------------------------------------------------
   Con la lista acotada a un turno (§8.0), este encabezado es el UNICO contexto
   que le queda al usuario: las filas ya no llevan fecha ni turno. Por eso se
   resalta cuando el turno no se abrio hoy — es la unica defensa contra dejarlo
   abierto de un dia para el otro y seguir numerando encima. *@
@if (_cargado)
{
    @if (_turno is null)
    {
        <div class="turno-aviso mb-3">
            <div>
                <strong>No hay turno de caja abierto.</strong>
                <div class="turno-aviso-detalle">Abrí uno para empezar a registrar pedidos.</div>
            </div>
            <AuthorizeView Roles="Admin,Cajero">
                <Authorized>
                    <button type="button" class="btn btn-primary" disabled="@_ocupado"
                            @onclick="() => _abriendo = true">Abrir turno</button>
                </Authorized>
            </AuthorizeView>
        </div>

        @* Sin turno abierto no hay grilla, y con ella se va el panel de filtros. Quien puede
           mirar el historico lo necesita igual —es justo cuando querria repasar el turno que
           acaba de cerrar—, asi que el selector reaparece aca solo. *@
        @if (_turnos.Count > 0)
        {
            <div class="turno-elegir mb-3">
                <label class="form-label" for="turno-anterior">Ver un turno anterior</label>
                <select id="turno-anterior" class="form-select" value="" @onchange="CambiarTurnoAsync">
                    <option value="">Elegir turno...</option>
                    @foreach (var t in _turnos)
                    {
                        <option value="@t.Id">@t.Nombre — @t.AbiertoEn.ToBoliviaTime().ToString("g")</option>
                    }
                </select>
            </div>
        }
    }
    else
    {
        <div class="turno-encabezado mb-3 @(DeOtroDia ? "otro-dia" : "")">
            <div class="turno-datos">
                <span class="turno-nombre">@_turno.Nombre</span>
                <span class="turno-meta">
                    @if (_turno.CerradoEn is null)
                    {
                        <span>abierto @_turno.AbiertoEn.ToBoliviaTime().ToString("HH:mm")</span>
                    }
                    else
                    {
                        <span class="turno-cerrado">cerrado</span>
                        <span>@_turno.AbiertoEn.ToBoliviaTime().ToString("g")</span>
                    }
                    @if (_turno.CajeroNombre is not null)
                    {
                        <span>Cajero: @_turno.CajeroNombre</span>
                    }
                    <span>@_turno.TotalPedidos @(_turno.TotalPedidos == 1 ? "pedido" : "pedidos")</span>
                </span>
                @if (DeOtroDia)
                {
                    <div class="turno-alerta">
                        Este turno se abrió el @_turno.AbiertoEn.ToBoliviaTime().ToString("d"), no hoy.
                    </div>
                }
            </div>
            <AuthorizeView Roles="Admin,Cajero">
                <Authorized>
                    @if (_turno.CerradoEn is null)
                    {
                        <div class="turno-acciones">
                            <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@_ocupado"
                                    @onclick="CerrarTurnoAsync">Cerrar turno</button>
                            <button type="button" class="btn btn-sm btn-primary" disabled="@_ocupado"
                                    @onclick="() => _abriendo = true">Nuevo turno</button>
                        </div>
                    }
                </Authorized>
            </AuthorizeView>
        </div>
    }

    @* Abrir turno pide un nombre, asi que es un formulario y no un boton solo. Cerrar el
       vigente y abrir el nuevo es UNA llamada: partirlo dejaria una ventana sin caja
       abierta en la que todo pedido que entre se rechaza (RN-6). *@
    @if (_abriendo)
    {
        <div class="turno-abrir mb-3">
            <label class="form-label" for="turno-nombre">Nombre del turno</label>
            <div class="turno-abrir-fila">
                <input id="turno-nombre" class="form-control" maxlength="40" @bind="_nombreTurno"
                       @bind:event="oninput" placeholder="Ejecutivo, A la carta, ..." />
                <button type="button" class="btn btn-primary" disabled="@(_ocupado || string.IsNullOrWhiteSpace(_nombreTurno))"
                        @onclick="AbrirTurnoAsync">Abrir</button>
                <button type="button" class="btn btn-outline-secondary" disabled="@_ocupado"
                        @onclick="CancelarApertura">Cancelar</button>
            </div>
            @if (_turno is { CerradoEn: null })
            {
                <div class="turno-abrir-nota">Se cerrará «@_turno.Nombre» y la numeración volverá a empezar en 001.</div>
            }
        </div>
    }
}

@if (_error is not null)
{
    <div class="alert alert-danger" role="alert">
        <div>@_error</div>
        @* El mensaje del trigger solo sabe cuantos son. Cuando el rechazo lo arma el
           controlador viene ademas la lista, y es la diferencia entre "andá a buscar tres
           pedidos" y saber cuales. *@
        @if (_bloqueantes.Count > 0)
        {
            <ul class="turno-bloqueantes">
                @foreach (var p in _bloqueantes)
                {
                    <li>
                        <a href="@($"/pedidos/{p.Id}")">
                            <strong>@p.NumeroTurno.ToString("D3")</strong>
                            @(string.IsNullOrWhiteSpace(p.Comensal) ? "(sin comensal)" : p.Comensal)
                            · @p.Estado.Etiqueta()
                        </a>
                    </li>
                }
            </ul>
        }
    </div>
}

@if (_cargado && _turno is not null)
{
    @* Los siete filtros eran siete columnas iguales. En el telefono se apilan y empujan
       la lista fuera de la pantalla, y en el escritorio pesan lo mismo aunque no se usen
       igual. Ahora: buscar por comensal y el estado siempre a la vista (son los dos que
       se tocan a cada rato), y los otros detras de "Filtros". *@
    <div class="filtros mb-3">
        <div class="filtros-buscar">
            <input class="form-control" @bind="_filtroComensal" @bind:event="oninput"
                   placeholder="Buscar comensal" aria-label="Buscar comensal" />
            <button type="button" class="btn btn-outline-secondary filtros-toggle @(HayFiltrosAvanzados ? "con-filtros" : "")"
                    aria-expanded="@_panelAbierto.ToString().ToLowerInvariant()"
                    @onclick="() => _panelAbierto = !_panelAbierto">
                Filtros@(HayFiltrosAvanzados ? $" ({CuantosFiltrosAvanzados})" : "")
            </button>
        </div>

        <div class="filtros-chips">
            <button type="button" class="filtro-chip @(_filtroEstado is null ? "activo" : "")"
                    @onclick="() => _filtroEstado = null">Todos</button>
            @foreach (var estado in _estadosFiltrables)
            {
                <button type="button" class="filtro-chip @(_filtroEstado == estado ? "activo" : "")"
                        @onclick="() => _filtroEstado = estado">@estado.Etiqueta()</button>
            }
        </div>

        @if (_panelAbierto)
        {
            <div class="filtros-panel row g-2">
                @* El filtro de turno sigue exactamente la division que ya existia en este
                   panel: quien no puede ver Id, Mesero ni Creado tampoco sale del turno
                   abierto (RN-12). Para el mesero, que canta "el 12" en el salon, el numero
                   tiene que ser inequivoco. La API lo vuelve a verificar. *@
@* N° queda FUERA del AuthorizeView a proposito: los filtros escondidos al mesero
                   lo estan porque amplian el alcance o son asunto de administracion (§8.0), y
                   este no hace ninguna de las dos — mueve dentro del turno, no fuera. Y es
                   justo su busqueda: el que canta "el 12" en el salon es el. *@
                <div class="col-6 col-md-2">
                    <label class="form-label">N°</label>
                    <input class="form-control" inputmode="numeric" placeholder="012"
                           @bind="_filtroNumero" @bind:event="oninput" />
                </div>
                <AuthorizeView Roles="Mesero,Delivery">
                    <NotAuthorized>
                        <div class="col-12 col-md-3">
                            <label class="form-label">Turno</label>
                            <select class="form-select" value="@(_idTurno?.ToString() ?? "")"
                                    @onchange="CambiarTurnoAsync">
                                <option value="">Turno abierto</option>
                                @foreach (var t in _turnos)
                                {
                                    <option value="@t.Id" selected="@(t.Id == _idTurno)">
                                        @t.Nombre — @t.AbiertoEn.ToBoliviaTime().ToString("g")
                                    </option>
                                }
                            </select>
                        </div>
                    </NotAuthorized>
                </AuthorizeView>
                <div class="col-6 col-md-3">
                    <label class="form-label">Tipo</label>
                    <select class="form-select" @bind="_filtroTipo">
                        <option value="">Todos</option>
                        @foreach (var tipo in Enum.GetValues<TipoPedido>())
                        {
                            <option value="@tipo">@tipo.Etiqueta()</option>
                        }
                    </select>
                </div>
                <AuthorizeView Roles="Mesero,Delivery">
                    <NotAuthorized>
                        <div class="col-6 col-md-3">
                            <label class="form-label">Mesero</label>
                            <select class="form-select" @bind="_filtroMesero">
                                <option value="">Todos</option>
                                @foreach (var mesero in _meserosDisponibles)
                                {
                                    <option value="@mesero.Id">@mesero.Nombre</option>
                                }
                            </select>
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label">Creado</label>
                            <input type="date" class="form-control" @bind="_filtroCreado" />
                        </div>
                    </NotAuthorized>
                </AuthorizeView>
                <div class="col-12 col-md-auto d-flex align-items-end">
                    <button type="button" class="btn btn-outline-secondary w-100" @onclick="LimpiarFiltrosAsync">Limpiar</button>
                </div>
            </div>
        }
    </div>

    @* El envoltorio no es decorativo: app.css alinea a la derecha la primera columna de
       la tabla que hay adentro, que es N°. Sin el, la regla alcanzaria a las otras ocho
       grillas de la aplicacion. *@
    <div class="grilla-pedidos">
        @* Delivery abre la ficha pero no escribe (specs/rol-delivery.md §8.2): por eso va en
           DetalleRoles y no en WriteRoles, que ademas encenderia "+ Nuevo". Y por eso el boton
           dice "Ver" y no "Editar" para el.

           OJO: este comentario va ACA y no entre los atributos del componente. Un comentario
           Razor dentro de la lista de atributos NO se trata como comentario: se manda como si
           fuera el nombre de un parametro, compila sin un solo warning y revienta en runtime
           con "does not have a property matching the name". Verificado. *@
        <EntityTable TEntity="Pedido"
                     Title="Pedidos"
                     Items="_pedidosOrdenados"
                     Columns="_columns"
                     TituloHeader="Comensal"
                     SortHeader="_ordenColumna"
                     SortDescending="_ordenDesc"
                     OnSort="Ordenar"
                     CreateUrl="/pedidos/nuevo"
                     EditUrlPrefix="/pedidos"
                     ShowDelete="false"
                     ShowCreate="@EsElTurnoAbierto"
                     WriteRoles="@(["Admin", "Mesero"])"
                     DetalleRoles="@(["Admin", "Mesero", "Delivery"])"
                     DetalleLabel="@(_puedeEditarPedidos ? "Editar" : "Ver")" />
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private TurnoDto? _turno;
    private List<Pedido>? _pedidos;
    private List<TurnoDto> _turnos = [];
    private bool _cargado;

    private Dictionary<long, string> _meseroNombres = [];
    private IReadOnlyDictionary<long, IReadOnlyList<int>> _mesasPorPedido = new Dictionary<long, IReadOnlyList<int>>();
    private List<(string Header, Func<Pedido, object?> Value)> _columns = [];

    private long? _idTurno;
    private string? _filtroNumero;
    private string? _filtroComensal;
    private EstadoPedido? _filtroEstado;
    private TipoPedido? _filtroTipo;
    private long? _filtroMesero;
    private DateOnly? _filtroCreado;

    private string? _error;
    private IReadOnlyList<PedidoVivoDto> _bloqueantes = [];
    private bool _abriendo;
    private bool _ocupado;
    private string _nombreTurno = "";

    // Los filtros que viven detras del boton. Se muestra cuantos hay puestos porque,
    // plegados, no hay ninguna otra senal de que la lista viene recortada.
    private bool _panelAbierto;

    private int CuantosFiltrosAvanzados =>
        (_idTurno is null ? 0 : 1)
        + (string.IsNullOrWhiteSpace(_filtroNumero) ? 0 : 1)
        + (_filtroTipo is null ? 0 : 1)
        + (_filtroMesero is null ? 0 : 1)
        + (_filtroCreado is null ? 0 : 1);

    private bool HayFiltrosAvanzados => CuantosFiltrosAvanzados > 0;

    private bool EsElTurnoAbierto => _turno is not null && _turno.CerradoEn is null;

    // Decide la etiqueta del boton que abre la ficha: "Editar" para quien edita, "Ver" para
    // quien solo mira (Delivery). Mismo corte por capacidad que Pedidos/Edit.razor.
    private bool _puedeEditarPedidos = true;

    // El turno que se abrio ayer y sigue abierto: la numeracion sigue subiendo sobre el
    // dia anterior y nadie se entera hasta que alguien mira el 214 de un martes.
    private bool DeOtroDia =>
        _turno is not null
        && _turno.CerradoEn is null
        && _turno.AbiertoEn.ToBoliviaDate() != DateTimeOffset.UtcNow.ToBoliviaDate();

    // El filtro de Estado solo ofrece los estados de un pedido "en curso": Cerrado/Anulado
    // quedan fuera a pedido del usuario. Ojo: eso es el FILTRO, no el alcance — la grilla
    // trae todos los pedidos del turno, pagados o no (RN-11).
    private static readonly EstadoPedido[] _estadosFiltrables =
        [EstadoPedido.Abierto, EstadoPedido.EnPreparacion, EstadoPedido.Servido];

    // Se filtra en memoria sobre los pedidos del turno ya cargado. Antes esto operaba sobre
    // GetAllAsync(), o sea sobre todos los pedidos que existieron; ahora la lista que llega
    // ya viene acotada por la API a un turno, que es un recorte con sentido operativo y no
    // una tabla entera esperando a crecer.
    private List<Pedido>? _pedidosFiltrados =>
        _pedidos?.Where(p =>
            CoincideElNumero(p) &&
            (string.IsNullOrWhiteSpace(_filtroComensal) || (p.Comensal ?? "").Contains(_filtroComensal.Trim(), StringComparison.OrdinalIgnoreCase)) &&
            (_filtroEstado is null || p.Estado == _filtroEstado) &&
            (_filtroTipo is null || p.Tipo == _filtroTipo) &&
            (_filtroMesero is null || p.IdMesero == _filtroMesero) &&
            (_filtroCreado is null || p.CreadoEn.ToBoliviaDate() == _filtroCreado))
        .ToList();

    // Coincidencia exacta, no Contains. Sobre el Id —una clave larga— la subcadena tenia
    // sentido; sobre un correlativo de una a tres cifras da sobre todo ruido: tipeando "1"
    // saldrian el 1, el 10 al 19, el 100 al 199 y el 21. Ademas la busqueda no es
    // exploratoria, el usuario ya sabe que numero quiere.
    //
    // Los ceros de relleno no cuentan: en pantalla se lee "012" y a mano se dice "el 12".
    // Lo que no sea un numero no devuelve nada, en vez de devolver todo.
    private bool CoincideElNumero(Pedido p)
    {
        if (string.IsNullOrWhiteSpace(_filtroNumero))
            return true;

        return int.TryParse(_filtroNumero.Trim(), out var buscado) && p.NumeroTurno == buscado;
    }

    // Orden por defecto: primero N° (SCRUM-18), luego Creado, Estado y por ultimo Comensal.
    private string _ordenColumna = "N°";
    private bool _ordenDesc = false;

    // Creado se ordena por DIA, no por instante. Si se ordenara por el timestamp completo los
    // otros dos criterios no llegarian a aplicarse nunca (cada pedido tiene su microsegundo),
    // y lo util es justamente lo contrario: ver el dia de hoy agrupado por estado. Es ademas
    // como ya trataba a Creado el filtro de esta misma pantalla.
    private static DateOnly DiaCreado(Pedido p) => p.CreadoEn.ToBoliviaDate();

    // "5", "5, 8" para varias, o "—" sin ninguna. El guion y no vacío: una celda en blanco en
    // una tabla se lee como dato faltante por cargar, no como "no aplica" (spec §4.1).
    private string FormatearMesas(long idPedido)
    {
        var numeros = _mesasPorPedido.GetValueOrDefault(idPedido);
        return numeros is null || numeros.Count == 0
            ? "—"
            : string.Join(", ", numeros);
    }

    // Falta a dónde entregar solo si no hay NINGUNA de las dos: con la referencia escrita
    // alcanza en un barrio conocido, y con el punto solo, el repartidor llega igual.
    //
    // El punto por defecto NO cuenta como punto: es el local, con el que arranca todo pedido
    // nuevo. Sin esta salvedad el aviso no se encendería jamás, porque siempre habría un par
    // de coordenadas cargado.
    private static bool SinDondeEntregar(Pedido p) =>
        string.IsNullOrWhiteSpace(p.DireccionEntrega)
        && (p.LatitudEntrega is null
            || UbicacionCompartida.EsReferenciaPorDefecto(p.LatitudEntrega, p.LongitudEntrega));

    // La columna elegida manda, y las demas quedan de desempate en el orden por defecto. Asi,
    // al ordenar por Estado, dentro de cada estado siguen apareciendo los mas recientes
    // primero en vez de en un orden arbitrario. Id cierra la cadena para que dos filas
    // identicas no se intercambien entre renders.
    //
    // N° NO entra en la cadena de desempate: dentro de un turno ordena exactamente igual que
    // Id, que ya la cierra. Sumarlo seria un criterio que nunca cambia nada.
    private List<Pedido>? _pedidosOrdenados
    {
        get
        {
            var filtrados = _pedidosFiltrados;
            if (filtrados is null)
                return null;

            var ordenados = _ordenColumna switch
            {
                // Por el entero, nunca por el texto de la columna: ordenar "010" y "009" como
                // cadenas los deja al reves de lo que se espera al pasar de 9 a 10.
                "N°" => Aplicar(filtrados, p => p.NumeroTurno),
                "Comensal" => Aplicar(filtrados, p => p.Comensal ?? "", StringComparer.CurrentCultureIgnoreCase),
                // Mesa menor de cada pedido; sin mesa asociada ordena como 0 (spec §4.2).
                "Mesa" => Aplicar(filtrados, p => _mesasPorPedido.GetValueOrDefault(p.Id)?.FirstOrDefault() ?? 0),
                "Estado" => Aplicar(filtrados, p => p.Estado),
                // Ordena por el valor del enum, no por la etiqueta: el orden de declaracion
                // (salon, para llevar, delivery) agrupa mejor que el alfabetico.
                "Tipo" => Aplicar(filtrados, p => p.Tipo),
                _ => Aplicar(filtrados, DiaCreado),
            };

            if (_ordenColumna != "Creado")
                ordenados = ordenados.ThenByDescending(DiaCreado);
            if (_ordenColumna != "Estado")
                ordenados = ordenados.ThenBy(p => p.Estado);
            if (_ordenColumna != "Comensal")
                ordenados = ordenados.ThenBy(p => p.Comensal ?? "", StringComparer.CurrentCultureIgnoreCase);

            return ordenados.ThenBy(p => p.Id).ToList();
        }
    }

    private IOrderedEnumerable<Pedido> Aplicar<TClave>(
        IEnumerable<Pedido> fuente, Func<Pedido, TClave> clave, IComparer<TClave>? comparador = null) =>
        _ordenDesc ? fuente.OrderByDescending(clave, comparador) : fuente.OrderBy(clave, comparador);

    // Misma columna: invierte. Otra columna: arranca ascendente, salvo Creado, donde lo que se
    // quiere ver primero es siempre lo mas reciente. N° ya no es una excepcion: el orden con el
    // que la grilla abre (§2.2, SCRUM-18) es justamente N° ascendente, asi que volver a el a
    // mano arranca igual, no al reves.
    private void Ordenar(string columna)
    {
        if (_ordenColumna == columna)
        {
            _ordenDesc = !_ordenDesc;
            return;
        }

        _ordenColumna = columna;
        _ordenDesc = columna is "Creado";
    }

    // Solo los meseros que efectivamente tienen pedidos, no todos los usuarios: evita opciones
    // muertas en el filtro.
    private List<(long Id, string Nombre)> _meserosDisponibles =>
        (_pedidos ?? [])
            .Select(p => p.IdMesero)
            .Distinct()
            .Select(id => (Id: id, Nombre: _meseroNombres.GetValueOrDefault(id, $"#{id}")))
            .OrderBy(m => m.Nombre)
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        var usuarios = await UsuarioApi.GetAllAsync();
        _meseroNombres = usuarios.ToDictionary(u => u.Id, u => u.Nombre);

        _columns =
        [
            // Padding a 3 digitos. Con mas de 999 pedidos en un turno pasa a 4 solo, sin
            // romper la columna; la alineacion a la derecha vive en app.css.
            ("N°", p => p.NumeroTurno.ToString("D3")),
            ("Comensal", p => p.Comensal),
            ("Mesa", p => FormatearMesas(p.Id)),
            ("Estado", p => p.Estado.Etiqueta()),
            // Se reporta, no se bloquea: un delivery sin dirección se factura igual, pero
            // tiene que verse en la lista. Ver specs/direccion-entrega.md §4.
            ("Tipo", p => p.Tipo == TipoPedido.Delivery && SinDondeEntregar(p)
                ? "Delivery · sin dirección"
                : p.Tipo.Etiqueta()),
            ("Creado", p => p.CreadoEn.ToBoliviaTime().ToString("g")),
        ];

        await CargarGrillaAsync();

        // El historico solo se pide para quien puede usar el filtro. Al mesero no se le
        // cobra una llamada por un control que no va a ver.
        if (AuthStateTask is not null)
        {
            var user = (await AuthStateTask).User;

            // Antes de _cargado: la grilla se dibuja recien ahi, y si esto quedara despues el
            // primer render le mostraria "Editar" a Delivery (specs/rol-delivery.md §8.2).
            _puedeEditarPedidos = user.IsInRole("Admin") || user.IsInRole("Mesero");

            if ((!user.IsInRole("Mesero") && !user.IsInRole("Delivery")) || user.IsInRole("Admin"))
                await CargarTurnosAsync();
        }

        _cargado = true;
    }

    private async Task CargarGrillaAsync()
    {
        try
        {
            var grilla = _idTurno is null
                ? await TurnoApi.GetGrillaAbiertaAsync()
                : await TurnoApi.GetGrillaAsync(_idTurno.Value);

            _turno = grilla.Turno;
            _pedidos = grilla.Pedidos.ToList();
            _mesasPorPedido = grilla.MesasPorPedido;
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
            _pedidos = [];
        }
        catch (HttpRequestException)
        {
            _error = "No se pudo conectar con el servidor.";
            _pedidos = [];
        }
    }

    private async Task CargarTurnosAsync()
    {
        try
        {
            _turnos = await TurnoApi.GetHistoricoAsync();
        }
        catch (ApiException)
        {
            // Sin historico el filtro queda con la unica opcion "Turno abierto", que es el
            // comportamiento del mesero. No vale romper la pantalla por un control opcional.
            _turnos = [];
        }
        catch (HttpRequestException)
        {
            _turnos = [];
        }
    }

    private async Task CambiarTurnoAsync(ChangeEventArgs e)
    {
        _idTurno = long.TryParse(e.Value?.ToString(), out var id) ? id : null;
        LimpiarError();
        await CargarGrillaAsync();
    }

    private void CancelarApertura()
    {
        _abriendo = false;
        _nombreTurno = "";
        LimpiarError();
    }

    private async Task AbrirTurnoAsync()
    {
        await EjecutarAsync(
            async () =>
            {
                await TurnoApi.AbrirAsync(_nombreTurno.Trim());
                _abriendo = false;
                _nombreTurno = "";
                _idTurno = null;
                await CargarGrillaAsync();
                await CargarTurnosAsync();
            },
            "Abriendo turno...");
    }

    private async Task CerrarTurnoAsync()
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"¿Cerrar el turno «{_turno?.Nombre}»?"))
            return;

        await EjecutarAsync(
            async () =>
            {
                await TurnoApi.CerrarAsync();
                _idTurno = null;
                await CargarGrillaAsync();
                await CargarTurnosAsync();
            },
            "Cerrando turno...");
    }

    // Mismo patron que Pedidos/Edit.razor: la accion bloquea la pantalla mientras corre, y
    // ademas deshabilita el boton. No es redundante — cierra la ventana entre el clic y el
    // overlay, en la que un segundo clic mandaria dos aperturas de turno.
    private async Task EjecutarAsync(Func<Task> accion, string mensaje)
    {
        LimpiarError();
        _ocupado = true;
        try
        {
            await Operaciones.BloquearAsync(accion, mensaje);
        }
        catch (CierreTurnoException ex)
        {
            _error = ex.Message;
            _bloqueantes = ex.Pedidos;
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        catch (HttpRequestException)
        {
            _error = "No se pudo conectar con el servidor.";
        }
        finally
        {
            _ocupado = false;
        }
    }

    private void LimpiarError()
    {
        _error = null;
        _bloqueantes = [];
    }

    // Limpiar incluye volver al turno abierto: el turno se cuenta como filtro puesto en el
    // contador del boton, asi que dejarlo puesto haria que "Limpiar" dejara el contador en 1.
    private async Task LimpiarFiltrosAsync()
    {
        _filtroNumero = null;
        _filtroComensal = null;
        _filtroEstado = null;
        _filtroTipo = null;
        _filtroMesero = null;
        _filtroCreado = null;

        if (_idTurno is not null)
        {
            _idTurno = null;
            LimpiarError();
            await CargarGrillaAsync();
        }
    }
}
