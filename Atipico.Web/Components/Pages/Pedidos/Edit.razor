@page "/pedidos/nuevo"
@page "/pedidos/{Id:long}"
@attribute [Authorize(Roles = "Admin,Mesero")]
@using System.Net
@using Atipico.Application.Common
@using System.Text.Json
@using System.Text.Json.Serialization
@inject IEntityApiClient<Pedido> Api
@inject IEntityApiClient<Usuario> UsuarioApi
@inject IEntityApiClient<Plato> PlatoApi
@inject IEntityApiClient<PedidoPlato> PedidoPlatoApi
@inject IEntityApiClient<Mesa> MesaApi
@inject IEntityApiClient<PedidoMesa> PedidoMesaApi
@inject IEntityApiClient<DetalleCuenta> DetalleCuentaApi
@inject IEntityApiClient<Cuenta> CuentaApi
@inject IComprobanteApiClient ComprobanteApi
@inject IHttpClientFactory HttpClientFactory
@inject EstadoOperaciones EstadoOperaciones
@inject IResolvedorEnlaceUbicacion ResolvedorEnlace
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>@Titulo</PageTitle>

<a href="/pedidos" class="btn btn-link ps-0 mb-2">&larr; Volver a pedidos</a>

@* El pedido se nombra como se lo nombra en el salon: por su numero de turno y por
   quien lo pidio. El id sigue estando en la URL —es la clave con la que se navega y es
   unica entre turnos, cosa que el correlativo no es— pero no se muestra: para el mesero
   no significa nada. *@
<h3>@Titulo</h3>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}

@if (_loaded)
{
    <EditForm Model="_entity" FormName="pedido-edit" OnValidSubmit="@(() => EjecutarAsync(HandleSave, "Guardando el pedido…"))">
        <div class="mb-3">
            <label class="form-label">Comensal</label>
            <InputText class="form-control" @bind-Value="_entity.Comensal" />
        </div>
        <div class="mb-3">
            <label class="form-label">Tipo de pedido</label>
            @* Se sabe antes de tomar el primer plato, por eso va arriba. Deshabilitado en un
               pedido que ya no esta Abierto: no hay boton que persista el cambio y quedaria
               como una edicion fantasma. Ver specs/tipo-pedido.md §5. *@
            <select class="form-select" @bind="_entity.Tipo" disabled="@(Id is not null && !_pedidoActivo)">
                @foreach (var tipo in Enum.GetValues<TipoPedido>())
                {
                    <option value="@tipo">@tipo.Etiqueta()</option>
                }
            </select>
        </div>
        @if (_entity.CerradoEn is not null)
        {
            <div class="mb-3">
                <label class="form-label">Cerrado en</label>
                <p class="form-control-plaintext">@_entity.CerradoEn.Value.ToBoliviaTime().ToString("g")</p>
            </div>
        }

        @* Las acciones NO estan aca: viven en la barra fija del final (ver mas abajo y
           specs/barra-acciones-pedido.md). OnValidSubmit se mantiene conectado igual, porque
           sin boton de submit el Enter en un campo de texto sigue enviando el formulario. *@
    </EditForm>

    <hr class="my-4" />

    <div class="row">
        <div class="@(_mostrarMesas || _mostrarEntrega ? "col-md-6" : "col-12")">
            <h4>Platos del pedido</h4>
            @if (Id is null)
            {
                <p class="text-muted"><em>Guarda el pedido primero para poder agregar platos.</em></p>
            }
            else
            {
                @if (_pedidoPlatos.Count == 0 && _platosPendientes.Count == 0)
                {
                    <p class="text-muted"><em>Sin platos agregados todavía.</em></p>
                }
                else
                {
                    <ul class="list-group mb-3">
                        @foreach (var pp in _pedidoPlatos)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span>
                                    @(_platos.FirstOrDefault(p => p.Id == pp.IdPlato)?.Nombre ?? $"#{pp.IdPlato}")
                                    <span class="badge bg-secondary ms-1">@pp.Estado</span>
                                </span>
                                @if (_pedidoActivo && pp.Estado != EstadoPedidoPlato.Anulado)
                                {
                                    <button type="button" class="btn btn-sm btn-danger" @onclick="() => HandleRemovePlato(pp.Id)">Quitar</button>
                                }
                            </li>
                        }
                        @for (var i = 0; i < _platosPendientes.Count; i++)
                        {
                            var index = i;
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span>
                                    @(_platos.FirstOrDefault(p => p.Id == _platosPendientes[index])?.Nombre ?? $"#{_platosPendientes[index]}")
                                    <span class="badge bg-warning text-dark ms-1">Sin guardar</span>
                                </span>
                                @if (_pedidoActivo)
                                {
                                    <button type="button" class="btn btn-sm btn-danger" @onclick="() => HandleQuitarPendiente(index)">Quitar</button>
                                }
                            </li>
                        }
                        @* Lo que va a salir cobrado si se factura ahora. No sustituye al monto
                           de la cuenta (esa la calcula PedidosController al pasar a
                           EnPreparacion): es la misma suma, adelantada, para que el mesero
                           pueda cantar el total en el mostrador sin sacar la calculadora.
                           Los anulados no suman, igual que en el detalle. *@
                        <li class="list-group-item d-flex justify-content-between align-items-center pedido-subtotal">
                            <span class="text-muted">Subtotal</span>
                            <strong>@Subtotal.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("es-BO"))</strong>
                        </li>
                    </ul>
                }
                @if (_pedidoActivo)
                {
                    @if (_platosHabilitadosHoy.Count > 0)
                    {
                        <div class="input-group mb-4">
                            <select class="form-select" @bind="_selectedPlatoId">
                                @foreach (var plato in _platosHabilitadosHoy)
                                {
                                    <option value="@plato.Id">@plato.Nombre</option>
                                }
                            </select>
                            <button type="button" class="btn btn-outline-primary" @onclick="HandleAddPlato">Agregar plato</button>
                        </div>
                        <p class="text-muted"><em>Los platos agregados se guardan recién al presionar "En Preparación".</em></p>
                    }
                    else
                    {
                        <p class="text-muted"><em>No hay platos habilitados para agregar hoy.</em></p>
                    }
                }
                else
                {
                    <p class="text-muted"><em>El pedido ya no está abierto; no se pueden agregar más platos.</em></p>
                }

                @* Zona de preparacion de comprobantes. Aparece al elegir Qr y va debajo de la
                   lista de platos: el mesero ve lo que esta cobrando y recien despues adjunta el
                   comprobante. La cuenta todavia no existe (la crea PedidosController al pasar a
                   EnPreparacion), asi que aca no se sube nada: se prepara. La subida real ocurre
                   en HandleCerrarPedido, ya con el IdCuenta. Ver specs/comprobantes-qr.md §8.1. *@
                @if (_pedidoActivo && _metodoPagoSeleccionado == MetodoPago.Qr)
                {
                    <div class="card mb-4 border-primary">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <span>
                                <strong>Comprobantes QR</strong>
                                <Ayuda Texto="Las imágenes quedan preparadas y se suben al pulsar En Preparación, que es cuando se crea la cuenta a la que se adjuntan." />
                            </span>
                            @if (_preparados.Count > 0)
                            {
                                <span class="badge bg-primary">@_preparados.Count preparado(s)</span>
                            }
                        </div>
                        <div class="card-body">
                            @if (_errorComprobante is not null)
                            {
                                <div class="alert alert-danger">@_errorComprobante</div>
                            }

                            @if (_preparados.Count > 0)
                            {
                                <ul class="list-group mb-3">
                                    @foreach (var pendiente in _preparados)
                                    {
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            <span>
                                                @pendiente.Nombre
                                                <small class="text-muted ms-2">@(pendiente.Contenido.Length / 1024) KB</small>
                                            </span>
                                            <button type="button" class="btn btn-sm btn-outline-danger"
                                                    @onclick="() => QuitarPreparado(pendiente)">Quitar</button>
                                        </li>
                                    }
                                </ul>
                            }

                            <div class="row g-2 align-items-end">
                                <div class="col-12">
                                    <label class="form-label">Imagen del comprobante</label>
                                    @* multiple: un comensal puede pagar con varios QR (saldo insuficiente,
                                       monto mal digitado). Cada archivo entra como un comprobante aparte. *@
                                    @* El @ref es el destino del salto al elegir Qr: el select
                                       vive en la barra fija del pie y esta zona esta arriba, asi
                                       que sin el salto la zona aparece fuera de pantalla. Ver
                                       specs/comprobantes-qr.md §8.1.1. *@
                                    <InputFile class="form-control comprobante-archivo" OnChange="PrepararComprobantesAsync"
                                               accept="image/*" multiple @key="_claveInputComprobante"
                                               @ref="_inputComprobante" />
                                    <div class="form-text">
                                        Opcional — solo la imagen
                                        <Ayuda Texto="El monto se extraerá automáticamente de la imagen. Si no adjuntas nada, el pedido se factura igual y la cuenta aparecerá en el reporte de evidencia de pagos QR." />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
        @if (_mostrarMesas)
        {
            <div class="col-md-6">
                <h4>Mesas del pedido</h4>
                @if (_entity.Tipo != TipoPedido.EnSalon)
                {
                    @* El tipo cambio despues de asociar la mesa. No se desasocia sola ni se
                       esconde: una mesa ocupada de forma invisible solo se liberaria al cerrar
                       el pedido, y nadie podria diagnosticarlo. Decide la persona. *@
                    <div class="alert alert-warning py-2">
                        Este pedido es <strong>@_entity.Tipo.Etiqueta()</strong> y tiene mesas asociadas.
                        Si ya no corresponde, quítalas para liberarlas.
                    </div>
                }
                @if (Id is null)
                {
                    <p class="text-muted"><em>Guarda el pedido primero para poder asociar mesas.</em></p>
                }
                else
                {
                    @if (_pedidoMesas.Count == 0)
                    {
                        <p class="text-muted"><em>Sin mesas asociadas todavía.</em></p>
                    }
                    else
                    {
                        <ul class="list-group mb-3">
                            @foreach (var pm in _pedidoMesas)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <span>Mesa @(_mesas.FirstOrDefault(m => m.Id == pm.IdMesa)?.Numero.ToString() ?? $"#{pm.IdMesa}")</span>
                                    @if (_puedeAsociarMesa)
                                    {
                                        <button type="button" class="btn btn-sm btn-danger" @onclick="() => HandleRemoveMesa(pm.Id)">Quitar</button>
                                    }
                                </li>
                            }
                        </ul>
                    }
                    @if (_puedeAsociarMesa)
                    {
                        @* Las ocupadas se listan pero no se pueden elegir. Antes se ofrecian
                           con un aviso al lado y se dejaban asociar igual; desde
                           sql/012_pedido_unicidad_por_turno.sql la base las rechaza, asi que
                           ofrecerlas seria prometer algo que la API niega. Se muestran, en vez
                           de esconderlas, para que el mesero vea que la mesa existe y por que
                           no la puede tomar. *@
                        @if (_mesasLibres.Count > 0)
                        {
                            <div class="input-group mb-4">
                                <select class="form-select" @bind="_selectedMesaId">
                                    @foreach (var mesa in _mesasDisponibles)
                                    {
                                        <option value="@mesa.Id" disabled="@(mesa.Estado == EstadoMesa.Ocupada)">
                                            Mesa @mesa.Numero (cap. @mesa.Capacidad)@(mesa.Estado == EstadoMesa.Ocupada ? " - ocupada por otro pedido" : "")
                                        </option>
                                    }
                                </select>
                                <button type="button" class="btn btn-outline-primary" @onclick="HandleAddMesa">Agregar mesa</button>
                            </div>
                        }
                        else if (_mesasDisponibles.Count > 0)
                        {
                            <p class="text-muted"><em>Todas las mesas están ocupadas por otros pedidos de este turno.</em></p>
                        }
                        else
                        {
                            <p class="text-muted"><em>No hay mesas disponibles para asociar.</em></p>
                        }
                    }
                    else
                    {
                        <p class="text-muted"><em>El pedido ya está cerrado o anulado; no se puede cambiar la mesa.</em></p>
                    }
                }
            </div>
        }
        @if (_mostrarEntrega)
        {
            <div class="col-md-6">
                <h4>Entrega</h4>

                @if (string.IsNullOrWhiteSpace(_entity.DireccionEntrega)
                     && (_entity.LatitudEntrega is null
                         || UbicacionCompartida.EsReferenciaPorDefecto(_entity.LatitudEntrega, _entity.LongitudEntrega)))
                {
                    @* Se avisa, no se bloquea: el pedido se factura igual sin esto. El punto
                       por defecto no cuenta como dirección — es el local, o sea el pedido
                       apuntando a sí mismo. *@
                    <div class="alert alert-warning py-2">
                        Este pedido es delivery y todavía no tiene a dónde ir: el punto sigue
                        siendo el del local.
                    </div>
                }

                <div class="mb-3">
                    <label class="form-label">Referencia</label>
                    @* Fuera del EditForm no hay EditContext, asi que van <textarea>/<input>
                       comunes con @@bind y no los componentes InputText/InputNumber. *@
                    <textarea class="form-control" rows="2" @bind="_entity.DireccionEntrega"
                              disabled="@_entregaBloqueada"
                              placeholder="Casa verde, media cuadra del surtidor"></textarea>
                    <div class="form-text">
                        Cómo llegar, en palabras
                        <Ayuda Texto="Es lo único que puede contradecir al pin: quien comparte su ubicación actual desde la oficina manda un punto que no es su casa." />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Ubicación</label>
                    <textarea class="form-control" rows="2" @bind="_entity.UbicacionCompartida"
                              @bind:after="LeerUbicacion" disabled="@_entregaBloqueada"
                              placeholder="Pega el enlace o las coordenadas"></textarea>
                    <div class="form-text">
                        Se guarda tal cual, aunque no se puedan leer las coordenadas
                        <Ayuda Texto="Acepta coordenadas, el enlace largo de Google Maps y el corto de maps.app.goo.gl, que se resuelve solo." />
                    </div>
                </div>

                @if (_avisoUbicacion is not null)
                {
                    <div class="alert alert-warning py-2">@_avisoUbicacion</div>
                }

                @{
                    // Sin punto propio el mapa igual se dibuja, centrado en el local: una caja
                    // gris no le dice nada a nadie, y ver el local ubica al mesero.
                    var lat = _entity.LatitudEntrega ?? UbicacionCompartida.LatitudPorDefecto;
                    var lng = _entity.LongitudEntrega ?? UbicacionCompartida.LongitudPorDefecto;
                }
                @* Mapa embebido de OpenStreetMap. Sin libreria ni interop: es un iframe,
                   asi que no hay ciclo de vida que manejar ni nada que liberar al salir
                   de la pantalla. Ver specs/mapa-entrega.md. *@
                <iframe class="w-100 border rounded mb-2" height="260"
                        loading="lazy" referrerpolicy="no-referrer"
                        title="Ubicación de entrega"
                        src="@UbicacionCompartida.EmbedMapa(lat, lng)"></iframe>

                @* El mapa y el enlace no compiten: el de arriba confirma de un vistazo que
                   el punto tiene sentido, este abre la app de mapas del telefono, que es
                   la que sabe navegar hasta ahi. Se arma con las coordenadas y no se reusa
                   el texto original: un enlace de "ubicacion en tiempo real" caduca a las
                   horas, un punto no. *@
                <div class="mb-3">
                    <a class="btn btn-sm btn-outline-primary" target="_blank" rel="noopener"
                       href="@UbicacionCompartida.EnlaceMapa(lat, lng)">Abrir para navegar</a>
                </div>

                @if (UbicacionCompartida.FueraDeBolivia(lat, lng))
                {
                    <div class="alert alert-warning py-2">
                        Ese punto no cae en Bolivia. Casi siempre significa que la latitud y
                        la longitud están invertidas.
                    </div>
                }

                <div class="mb-3">
                    <label class="form-label">Coordenadas</label>
                    @* Un solo campo y no dos numericos: Google Maps copia el par junto
                       ("-17.76, -63.19") y partirlo obligaba a cortarlo a mano. De paso vuelve
                       inalcanzable a ck_pedido_coordenada, porque no hay forma de dejar una
                       sola de las dos. *@
                    <input class="form-control" @bind="_coordenadasTexto" @bind:after="LeerCoordenadas"
                           disabled="@_entregaBloqueada" placeholder="-17.763701, -63.199920" />
                    <div class="form-text">
                        Se llenan solas al pegar arriba; se pueden pegar directo de Google Maps
                        <Ayuda Texto="En Google Maps, pulsación larga sobre el punto y después un toque en las coordenadas para copiarlas." />
                    </div>
                </div>

                @if (_errorCoordenadas is not null)
                {
                    <div class="alert alert-danger py-2">@_errorCoordenadas</div>
                }
            </div>
        }
    </div>

    @* Pago adelantado: al pasar a "En Preparación", PedidosController factura y crea la
       Cuenta con el metodo elegido. Si fue QR, el comprobante se adjunta aca mismo — el
       mesero lo verifica en el mostrador, con el pedido delante, sin ir a la pantalla de
       caja. Un pedido puede haber generado mas de una cuenta a lo largo de su vida. *@
    @if (_cuentasQr.Count > 0)
    {
        <hr class="my-4" />
        <h4>Comprobantes de pago</h4>
        @foreach (var cuenta in _cuentasQr)
        {
            <ComprobantesPanel IdCuenta="cuenta.Id"
                               Monto="cuenta.Monto"
                               MetodoPago="cuenta.MetodoPago"
                               PuedeEditar="@(cuenta.Estado != EstadoCuenta.Anulada)" />
        }
    }

    @* --- Barra de acciones ---------------------------------------------------
       Fija al pie, siempre visible. Antes este bloque estaba arriba de todo y debajo
       quedaban tres pantallas de formulario: el mesero adjuntaba el comprobante abajo
       y el boton que factura estaba tres pantallas arriba.

       Se declara al FINAL y no dentro del EditForm —position: fixed no depende de donde
       se declare— para que el orden del DOM coincida con el visual, que es lo que leen
       el lector de pantalla y el tabulador. Ver specs/barra-acciones-pedido.md §5.

       Sin acciones disponibles (Cerrado, Anulado) no se dibuja nada: ni barra ni
       espaciador, asi que no queda un hueco blanco sin motivo. *@
    @if (HayAcciones)
    {
        @* En el flujo normal, reservando el alto de la barra. No se toca el
           padding-bottom de .content: eso alcanza a todas las pantallas y solo esta
           tiene barra.

           Dos alturas porque la barra tiene dos: en movil el select de metodo de pago
           toma el ancho completo y empuja los botones a una segunda fila. Medido a
           320px: 122px con select, 66px sin el. Un solo valor dejaria 70px de hueco
           en blanco en los otros tres estados. Ver specs/barra-acciones-pedido.md §6.2. *@
        <div class="pedido-barra-espaciador @(BarraConMetodo ? "con-metodo" : "")"></div>

        <div class="pedido-barra-acciones">
            <div class="pedido-barra-interior">
                @if (Id is null)
                {
                    @* type="button" y no submit: la barra vive fuera del EditForm. Es
                       equivalente porque el formulario no tiene DataAnnotationsValidator,
                       asi que OnValidSubmit nunca filtro nada. *@
                    <button type="button" class="btn btn-primary" disabled="@_procesando"
                            @onclick="@(() => EjecutarAsync(HandleSave, "Guardando el pedido…"))">
                        Continuar
                    </button>
                }
                @if (BarraConMetodo)
                {
                    @* El select viaja con el boton a proposito: sin el, la barra mostraria un
                       boton gris sin ninguna pista de que lo desbloquea y con el control fuera
                       de pantalla. Eso es peor que no tener barra. *@
                    <select class="form-select pedido-barra-metodo" @bind="_metodoPagoSeleccionado"
                            @bind:after="AlElegirMetodoPago" aria-label="Método de pago">
                        <option value="">-- Método de pago --</option>
                        @foreach (var metodo in Enum.GetValues<MetodoPago>())
                        {
                            <option value="@metodo">@metodo</option>
                        }
                    </select>
                    @* La accion mas lenta de la aplicacion: guarda los platos pendientes,
                       factura creando la cuenta y su detalle, y sube a R2 los comprobantes
                       preparados. Por eso va con overlay y no solo con la barra de progreso. *@
                    <button type="button" class="btn btn-primary"
                            disabled="@(_metodoPagoSeleccionado is null || _procesando)"
                            @onclick="@(() => EjecutarAsync(HandleCerrarPedido, "Facturando el pedido y subiendo los comprobantes…"))">
                        En Preparación
                    </button>
                }
                @if (_puedeMarcarServido)
                {
                    <button type="button" class="btn btn-success" disabled="@_procesando"
                            @onclick="@(() => EjecutarAsync(HandleMarcarServido, "Marcando como servido…"))">Servido</button>
                }
                @if (_puedeAnular)
                {
                    <button type="button" class="btn btn-outline-secondary" disabled="@_procesando"
                            @onclick="@(() => EjecutarAsync(HandleAnularPedido, "Anulando el pedido…"))">Anular</button>
                }
            </div>
        </div>
    }
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    [Parameter] public long? Id { get; set; }
    private Pedido _entity = new();

    // Destino del salto al elegir Qr, y bandera que lo pide.
    //
    // El select de metodo de pago se mudo a la barra fija del pie; la zona de comprobantes
    // sigue arriba, en la columna de platos. Antes el select estaba justo encima de ella y
    // elegir Qr la hacia aparecer debajo del cursor; ahora se elige abajo y la zona nace
    // fuera de pantalla. Ver specs/comprobantes-qr.md §8.1.1.
    private InputFile? _inputComprobante;
    private bool _irAComprobantes;

    // Solo en la TRANSICION a Qr. Abrir un pedido que ya lo tenia elegido no mueve nada:
    // no es una eleccion del usuario, y correrle la pantalla sin que haya tocado nada es
    // peor que no hacer nada.
    private void AlElegirMetodoPago()
    {
        if (_metodoPagoSeleccionado == MetodoPago.Qr)
            _irAComprobantes = true;
    }

    // El salto se ejecuta aca y no en AlElegirMetodoPago porque la zona no existe hasta que
    // Blazor vuelve a dibujar con el metodo ya elegido: enfocarla en el mismo instante del
    // cambio apuntaria a un elemento que todavia no esta en el DOM.
    //
    // FocusAsync y no un scrollIntoView por interop: enfocar ya desplaza, el campo de
    // archivo es exactamente lo siguiente que se toca, y el proyecto no tiene ningun archivo
    // JavaScript propio — un scroll no justifica ser el primero.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_irAComprobantes)
            return;

        _irAComprobantes = false;

        var input = _inputComprobante?.Element;
        if (input is not null)
            await input.Value.FocusAsync();
    }

    // Como se llama este pedido en pantalla. Antes era "Editar pedido #12", el id de la
    // tabla; ahora es "Pedido 012 · Juan", que es lo que se canta en el salon.
    //
    // Se calcula fuera del @if (_loaded) porque el encabezado se dibuja antes de que
    // termine la carga: hasta entonces no hay numero que mostrar y decir "Pedido" solo es
    // mejor que mostrar un 000 que no existe.
    private string Titulo
    {
        get
        {
            if (Id is null)
                return "Nuevo pedido";

            if (!_loaded)
                return "Pedido";

            var numero = _entity.NumeroTurno.ToString("D3");
            return string.IsNullOrWhiteSpace(_entity.Comensal) ? $"Pedido {numero}" : $"Pedido {numero} · {_entity.Comensal}";
        }
    }
    private List<Usuario> _meseros = [];
    private List<Plato> _platos = [];
    private List<PedidoPlato> _pedidoPlatos = [];
    private List<long> _platosPendientes = [];

    // Suma de los platos que hoy se facturarian: los guardados que no estan anulados mas
    // los todavia sin guardar. Un plato borrado de la carta despues de haberse pedido no
    // aparece en _platos y suma 0; es preferible a no mostrar nada, y el monto real lo
    // sigue calculando la API contra el precio del momento.
    private decimal Subtotal =>
        _pedidoPlatos
            .Where(pp => pp.Estado != EstadoPedidoPlato.Anulado)
            .Sum(pp => _platos.FirstOrDefault(p => p.Id == pp.IdPlato)?.Precio ?? 0m)
        + _platosPendientes
            .Sum(id => _platos.FirstOrDefault(p => p.Id == id)?.Precio ?? 0m);
    private long _selectedPlatoId;
    private List<Mesa> _mesas = [];
    private List<PedidoMesa> _pedidoMesas = [];
    private List<Cuenta> _cuentasQr = [];

    // Comprobantes preparados: se leen a memoria al elegirlos y se suben recien cuando
    // existe la cuenta. Ver specs/comprobantes-qr.md §8.1.
    private readonly List<ComprobantePreparado> _preparados = [];
    private string? _errorComprobante;
    private Guid _claveInputComprobante = Guid.NewGuid();

    // Mismo tope que ComprobantesPanel y que RequestSizeLimit en ComprobantesController.
    private const long TamanoMaximoComprobante = 15 * 1024 * 1024;

    private sealed record ComprobantePreparado(string Nombre, string TipoContenido, byte[] Contenido);
    private long _selectedMesaId;
    private MetodoPago? _metodoPagoSeleccionado;
    private bool _loaded;
    private string? _error;

    private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web)
    {
        Converters = { new JsonStringEnumConverter() }
    };

    // Dos o mas pedidos pueden compartir una mesa (p.ej. grupos distintos en una mesa grande),
    // por eso no se excluyen las mesas Ocupadas: solo se descartan Reservada/Inactiva (estados
    // manuales del personal, ver PedidoMesasController) y las que ya estan en este pedido.
    private List<Mesa> _mesasDisponibles =>
        _mesas.Where(m => m.Estado != EstadoMesa.Reservada && m.Estado != EstadoMesa.Inactiva
                           && _pedidoMesas.All(pm => pm.IdMesa != m.Id)).ToList();

    // _platos completo se sigue usando para resolver el nombre de platos ya agregados al
    // pedido (aunque hoy ya no esten activos/vigentes); solo el selector de "Agregar plato" se
    // limita a los Activos con HabilitadoDesde/HabilitadoHasta vigente para la fecha de hoy.
    private List<Plato> _platosHabilitadosHoy
    {
        get
        {
            // ToBoliviaDate y no DateTime.UtcNow: con UTC-4 la fecha UTC cambia a las
            // 20:00 de acá, y un plato habilitado "hasta hoy" se caía del menú en plena cena.
            var hoy = DateTimeOffset.UtcNow.ToBoliviaDate();
            return _platos.Where(p => p.Activo && p.HabilitadoDesde <= hoy && (p.HabilitadoHasta is null || p.HabilitadoHasta >= hoy)).ToList();
        }
    }

    // Se preselecciona una mesa Libre para evitar elegir por accidente una que ya esta
    // compartida; si no queda ninguna Libre, se cae a la primera disponible (Ocupada) en vez
    // de dejar el selector vacio.
    // Las que se pueden tomar de verdad. Una mesa Ocupada la rechaza tg_pedido_mesa_ocupada,
    // asi que no sirve ni como opcion ni como valor por defecto.
    private List<Mesa> _mesasLibres =>
        _mesasDisponibles.Where(m => m.Estado != EstadoMesa.Ocupada).ToList();

    // Sin fallback a una ocupada: antes, con todas las mesas tomadas, el select arrancaba
    // sobre una que el servidor iba a rechazar. Ahora arranca en 0 y HandleAddMesa no hace
    // nada, que es lo correcto cuando no hay nada que asociar.
    private long _mesaPorDefecto => _mesasLibres.FirstOrDefault()?.Id ?? 0;

    // "Cerrar pedido" solo es valido mientras el pedido esta Abierto (tomando el pedido); una
    // vez que pasa a En Preparacion queda en manos de cocina y ya no se edita desde aca.
    private bool _mostrarEntrega => _entity.Tipo == TipoPedido.Delivery;

    // Editable mientras el pedido este Abierto, o mientras todavia no exista: una vez
    // facturado se sigue viendo (el repartidor la necesita) pero ya no se toca.
    private bool _entregaBloqueada => Id is not null && !_pedidoActivo;

    private string? _avisoUbicacion;

    // El texto se guarda aparte de _entity en vez de calcularse al vuelo: si lo tecleado no
    // se puede leer, tiene que quedar a la vista junto al error. Un getter derivado de
    // _entity lo borraria en el siguiente render.
    private string? _coordenadasTexto;
    private string? _errorCoordenadas;

    private void SincronizarCoordenadas() =>
        _coordenadasTexto = _entity.LatitudEntrega is decimal la && _entity.LongitudEntrega is decimal lo
            ? UbicacionCompartida.Formatear(la, lo)
            : null;

    private void LeerCoordenadas()
    {
        _errorCoordenadas = null;

        // Vaciar el campo borra el punto. Las dos juntas: ck_pedido_coordenada no admite
        // media coordenada.
        if (string.IsNullOrWhiteSpace(_coordenadasTexto))
        {
            _entity.LatitudEntrega = null;
            _entity.LongitudEntrega = null;
            return;
        }

        if (UbicacionCompartida.TryExtraer(_coordenadasTexto, out var lat, out var lng))
        {
            _entity.LatitudEntrega = lat;
            _entity.LongitudEntrega = lng;
            // Se reescribe normalizado: lo pegado puede traer parentesis o espacios de mas.
            _coordenadasTexto = UbicacionCompartida.Formatear(lat, lng);
            return;
        }

        _errorCoordenadas = "Eso no parece un par de coordenadas. Se espera algo como "
                          + "-17.763701, -63.199920.";
    }

    // Corre al salir del campo, no en cada tecla: pegar un enlace largo dispararia el parser
    // decenas de veces sin necesidad.
    private async Task LeerUbicacion()
    {
        _avisoUbicacion = null;

        if (string.IsNullOrWhiteSpace(_entity.UbicacionCompartida))
            return;

        // Primero sin salir a la red: un texto que ya trae coordenadas no necesita ninguna
        // peticion.
        if (UbicacionCompartida.TryExtraer(_entity.UbicacionCompartida, out var lat, out var lng))
        {
            FijarPunto(lat, lng);
            return;
        }

        // Un maps.app.goo.gl no trae coordenadas: hay que seguir su redirect. Se envuelve en
        // SeguirAsync para que la barra global acompañe la espera, como a cualquier otra
        // llamada. Ver specs/enlace-corto-ubicacion.md.
        var resolucion = await EstadoOperaciones.SeguirAsync(
            () => ResolvedorEnlace.ResolverAsync(_entity.UbicacionCompartida));

        if (resolucion.Resuelto)
        {
            FijarPunto(resolucion.Latitud!.Value, resolucion.Longitud!.Value);
            return;
        }

        // No se borra lo que ya haya en latitud/longitud: pueden venir de una correccion a
        // mano, y perderlas por pegar un enlace ilegible seria peor que no leerlo.
        //
        // Dos mensajes distintos a proposito. "Era un enlace de Google y no se pudo consultar"
        // y "este texto no tiene coordenadas" se arreglan de formas distintas, y con un solo
        // mensaje generico no habria manera de saber cual de las dos paso.
        _avisoUbicacion = resolucion.SeIntento
            ? "Es un enlace de Google Maps, pero no se pudo consultar. Abrilo en el navegador y "
            + "pegá acá la dirección larga que aparece en la barra de direcciones."
            : "No se pudieron leer coordenadas de ese texto. Se guarda igual, y el repartidor "
            + "puede abrirlo; si querés el punto, cargalo abajo a mano.";
    }

    private void FijarPunto(decimal latitud, decimal longitud)
    {
        _entity.LatitudEntrega = latitud;
        _entity.LongitudEntrega = longitud;
        SincronizarCoordenadas();
        _errorCoordenadas = null;
    }

    // Para llevar y delivery no usan mesa, asi que la seccion desaparece... salvo que el
    // pedido ya tenga mesas asociadas, en cuyo caso hay que poder verlas para quitarlas.
    private bool _mostrarMesas =>
        _entity.Tipo == TipoPedido.EnSalon || _pedidoMesas.Count > 0;

    private bool _pedidoActivo =>
        Id is not null && _entity.Estado == EstadoPedido.Abierto;

    // "Servido" solo es valido una vez que cocina ya factura el pedido (EnPreparacion); no hay
    // un campo ServidoEn en Pedido (a diferencia de PedidoPlato), asi que la transicion es un
    // simple cambio de Estado.
    private bool _puedeMarcarServido =>
        Id is not null && _entity.Estado == EstadoPedido.EnPreparacion;

    // A diferencia de "En Preparación" (solo desde Abierto), un pedido se puede anular en
    // cualquier momento antes de Cerrado/Anulado; por eso "Anular" se saco de la grilla de
    // Pedidos/Index.razor y solo se ofrece entrando a editar el pedido.
    // Union de las cuatro condiciones de la barra, declarada una sola vez para que la
    // barra y su espaciador no puedan discrepar. Si discreparan, un pedido Cerrado
    // dejaria un hueco blanco al final sin nada que lo explique.
    private bool HayAcciones => Id is null || _pedidoActivo || _puedeMarcarServido || _puedeAnular;

    // Si la barra lleva el select de metodo de pago. Lo consultan el propio select y la
    // clase del espaciador: en movil el select ocupa una fila entera, asi que decide el
    // alto de la barra. Declarado una sola vez porque discrepar por defecto de menos
    // taparia el ultimo bloque del formulario, que es lo que el espaciador evita.
    private bool BarraConMetodo => _pedidoActivo;

    private bool _puedeAnular =>
        Id is not null && _entity.Estado != EstadoPedido.Cerrado && _entity.Estado != EstadoPedido.Anulado;

    // A diferencia de los platos (atados al timing de cocina, solo mientras esta Abierto), la
    // mesa se puede seguir asociando/quitando mientras el pedido siga vivo de cualquier forma
    // (Abierto, EnPreparacion, Servido); solo se bloquea al Cerrar o Anular, que es cuando
    // PedidosController.Update ya libera la mesa de todas formas.
    private bool _puedeAsociarMesa =>
        Id is not null && _entity.Estado != EstadoPedido.Cerrado && _entity.Estado != EstadoPedido.Anulado;

    protected override async Task OnInitializedAsync()
    {
        _meseros = await UsuarioApi.GetAllAsync();
        _platos = await PlatoApi.GetAllAsync();
        // Igual que _platos: se carga sin condicion, no solo dentro de LoadAsociaciones(), para
        // que _mesaPorDefecto ya tenga datos reales desde "Nuevo pedido" y no se quede en 0
        // (ver HandleSave, que la vuelve a cargar despues de crear por la misma razon).
        _mesas = await MesaApi.GetAllAsync();

        if (Id is not null)
        {
            var existing = await Api.GetByIdAsync(Id.Value);
            if (existing is null)
            {
                Nav.NavigateTo("/pedidos");
                return;
            }
            _entity = existing;

            await LoadAsociaciones();
        }
        else
        {
            _entity.IdMesero = await CurrentUsuarioIdAsync() ?? (_meseros.Count > 0 ? _meseros[0].Id : 0);

            // Arranca en el local. No es la direccion de entrega de nadie: es un punto de
            // partida para mover. Por eso EsReferenciaPorDefecto sigue tratando al pedido
            // como "sin direccion" mientras nadie lo haya movido.
            _entity.LatitudEntrega = UbicacionCompartida.LatitudPorDefecto;
            _entity.LongitudEntrega = UbicacionCompartida.LongitudPorDefecto;
        }

        SincronizarCoordenadas();

        if (_platosHabilitadosHoy.Count > 0) _selectedPlatoId = _platosHabilitadosHoy[0].Id;
        _selectedMesaId = _mesaPorDefecto;

        _loaded = true;
    }

    private async Task<long?> CurrentUsuarioIdAsync()
    {
        if (AuthStateTask is null) return null;

        var authState = await AuthStateTask;
        var claim = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        return long.TryParse(claim, out var id) ? id : null;
    }

    private async Task LoadAsociaciones()
    {
        var todosPlatos = await PedidoPlatoApi.GetAllAsync();
        _pedidoPlatos = todosPlatos.Where(pp => pp.IdPedido == Id).ToList();

        // Se recarga _mesas junto con la asociacion porque PedidoMesasController cambia
        // Mesa.Estado (Libre/Ocupada) al asociar/desasociar, y el dropdown de mesas
        // disponibles depende de ese estado estando al dia.
        _mesas = await MesaApi.GetAllAsync();
        var todasMesas = await PedidoMesaApi.GetAllAsync();
        _pedidoMesas = todasMesas.Where(pm => pm.IdPedido == Id).ToList();

        await LoadCuentasQrAsync();
    }

    // Se copia el contenido a memoria en el momento de elegir el archivo. Conservar el
    // IBrowserFile hasta despues de facturar es fragil: es una referencia que se lee por el
    // circuito SignalR y cualquier recomposicion del InputFile la invalida.
    private async Task PrepararComprobantesAsync(InputFileChangeEventArgs e)
    {
        _errorComprobante = null;

        foreach (var archivo in e.GetMultipleFiles())
        {
            try
            {
                // No es una llamada HTTP, pero se espera igual: los bytes viajan del
                // navegador al servidor por el circuito SignalR y una foto de telefono
                // tarda. Sin esto la pantalla se queda muda justo en esa espera.
                using var memoria = new MemoryStream();
                await EstadoOperaciones.SeguirAsync(async () =>
                {
                    await using var origen = archivo.OpenReadStream(TamanoMaximoComprobante);
                    await origen.CopyToAsync(memoria);
                });

                _preparados.Add(new ComprobantePreparado(
                    archivo.Name,
                    string.IsNullOrWhiteSpace(archivo.ContentType) ? "application/octet-stream" : archivo.ContentType,
                    memoria.ToArray()));
            }
            catch (IOException)
            {
                _errorComprobante = $"\"{archivo.Name}\" supera el tamaño máximo de {TamanoMaximoComprobante / (1024 * 1024)} MB.";
            }
        }

        _claveInputComprobante = Guid.NewGuid();
    }

    private void QuitarPreparado(ComprobantePreparado pendiente)
    {
        _preparados.Remove(pendiente);
        _errorComprobante = null;
    }

    // Se llama despues de facturar, cuando la cuenta ya existe. Un fallo aca NO revierte la
    // cuenta: el dinero entro y el registro debe reflejarlo. Se avisa y la cuenta queda en el
    // reporte de evidencia incompleta, que existe justamente para eso.
    private async Task<string?> SubirPreparadosAsync()
    {
        if (_preparados.Count == 0)
            return null;

        // Solo lo necesario para encontrar la cuenta recien creada. LoadAsociaciones()
        // recargaria ademas mesas y pedido-mesas: dos consultas de tabla completa que la
        // facturacion no altera, porque pasar a EnPreparacion no libera mesas.
        var todosPlatos = await PedidoPlatoApi.GetAllAsync();
        _pedidoPlatos = todosPlatos.Where(pp => pp.IdPedido == Id).ToList();
        await LoadCuentasQrAsync();

        var cuenta = _cuentasQr.OrderByDescending(c => c.Id).FirstOrDefault();
        if (cuenta is null)
            return "El pedido se facturó, pero no se encontró la cuenta QR para adjuntar los comprobantes.";

        var fallidos = new List<string>();

        foreach (var pendiente in _preparados.ToList())
        {
            try
            {
                using var contenido = new MemoryStream(pendiente.Contenido, writable: false);
                await ComprobanteApi.RegistrarAsync(
                    cuenta.Id, contenido, pendiente.Nombre, pendiente.TipoContenido);

                _preparados.Remove(pendiente);
            }
            catch (ApiException ex)
            {
                fallidos.Add($"{pendiente.Nombre}: {ex.Message}");
            }
            catch (HttpRequestException)
            {
                fallidos.Add($"{pendiente.Nombre}: no se pudo conectar con el servidor.");
            }
        }

        return fallidos.Count == 0
            ? null
            : "El pedido se facturó correctamente, pero no se pudieron subir algunos comprobantes: "
              + string.Join(" | ", fallidos)
              + ". Adjúntalos desde la cuenta #" + cuenta.Id + ".";
    }

    // No hay FK directa de Pedido a Cuenta: el vinculo es
    // Pedido -> PedidoPlato -> DetalleCuenta -> Cuenta. Se recorre esa cadena para saber
    // que cuentas genero este pedido y quedarse solo con las de QR, que son las unicas
    // que admiten comprobante (lo impone fn_comprobante_inmutable).
    private async Task LoadCuentasQrAsync()
    {
        var idsPedidoPlato = _pedidoPlatos.Select(pp => pp.Id).ToHashSet();
        if (idsPedidoPlato.Count == 0)
        {
            _cuentasQr = [];
            return;
        }

        var detalles = await DetalleCuentaApi.GetAllAsync();
        var idsCuenta = detalles.Where(d => idsPedidoPlato.Contains(d.IdPedidoPlato))
                                .Select(d => d.IdCuenta)
                                .ToHashSet();

        if (idsCuenta.Count == 0)
        {
            _cuentasQr = [];
            return;
        }

        var cuentas = await CuentaApi.GetAllAsync();
        _cuentasQr = cuentas.Where(c => idsCuenta.Contains(c.Id) && c.MetodoPago == MetodoPago.Qr)
                            .OrderBy(c => c.Id)
                            .ToList();
    }

    private bool _procesando;

    // Envuelve las acciones de la barra de botones: bloquea la pantalla mientras corren y
    // deshabilita los botones. Lo segundo importa aparte del bloqueo en "En Preparacion",
    // porque un doble clic ahi intenta facturar dos veces. El servidor ya lo rechaza
    // (PedidosController solo factura en la transicion Abierto -> EnPreparacion), pero la
    // interfaz no deberia ni ofrecerlo.
    private async Task EjecutarAsync(Func<Task> accion, string mensaje)
    {
        if (_procesando)
            return;

        _procesando = true;

        try
        {
            await EstadoOperaciones.BloquearAsync(accion, mensaje);
        }
        finally
        {
            // En finally: si la accion falla, los botones tienen que volver a habilitarse o
            // la pantalla queda muerta sin forma de reintentar.
            _procesando = false;
        }
    }

    private async Task HandleSave()
    {
        try
        {
            if (Id is null)
            {
                var created = await Api.CreateAsync(_entity);
                // Blazor reutiliza esta misma instancia de componente al navegar entre
                // "/pedidos/nuevo" y "/pedidos/{Id}" (mismo tipo de componente), asi que
                // OnInitializedAsync no se vuelve a ejecutar: sin esto, _entity.Id se queda
                // en 0 y el siguiente UpdateAsync (p.ej. "En Preparación") apunta a un pedido
                // inexistente.
                _entity = created!;

                // Misma reutilizacion de instancia que arriba: se refresca _mesas por si el
                // estado de alguna cambio entre cargar "Nuevo pedido" y presionar "Continuar",
                // y se recalcula _selectedMesaId; si no, quedaria en el valor calculado cuando
                // _mesas todavia estaba vacia (0), y "Agregar mesa" no haria nada aunque el
                // select se vea con una mesa marcada (el browser marca la primera opcion del
                // DOM aunque no coincida con el valor enlazado).
                _mesas = await MesaApi.GetAllAsync();
                _selectedMesaId = _mesaPorDefecto;

                Nav.NavigateTo($"/pedidos/{_entity.Id}");
            }
            else
            {
                await Api.UpdateAsync(_entity);
                Nav.NavigateTo("/pedidos");
            }
        }
        catch (ApiException ex)
        {
            _error = $"Error al guardar: {ex.Message}";
        }
        catch (HttpRequestException)
        {
            _error = "Error al guardar: no se pudo conectar con el servidor.";
        }
    }

    // "Cerrar pedido" no cierra el pedido (Estado Cerrado): guarda el detalle pendiente y
    // manda el pedido a cocina, pasandolo de Abierto a EnPreparacion. El cierre real del
    // pedido (facturacion via Cuenta) queda para otra pantalla/flujo.
    private async Task HandleCerrarPedido()
    {
        if (Id is null) return;

        if (_metodoPagoSeleccionado is null)
        {
            _error = "Selecciona un método de pago antes de pasar el pedido a En Preparación.";
            return;
        }

        if (!await GuardarPlatosPendientesAsync())
            return;

        var actualizado = new Pedido
        {
            Id = _entity.Id,
            Comensal = _entity.Comensal,
            Estado = EstadoPedido.EnPreparacion,
            Tipo = _entity.Tipo,
            IdMesero = _entity.IdMesero,
            DireccionEntrega = _entity.DireccionEntrega,
            UbicacionCompartida = _entity.UbicacionCompartida,
            LatitudEntrega = _entity.LatitudEntrega,
            LongitudEntrega = _entity.LongitudEntrega,
        };

        try
        {
            await ActualizarPedidoConMetodoPagoAsync(actualizado, _metodoPagoSeleccionado.Value);

            // La cuenta ya existe: recien ahora los comprobantes preparados tienen a que
            // colgarse. Si algo falla aca NO se revierte la facturacion (el dinero entro):
            // se queda en la pantalla mostrando que paso y como regularizarlo.
            var errorComprobantes = await SubirPreparadosAsync();
            if (errorComprobantes is not null)
            {
                _error = errorComprobantes;
                _entity.Estado = EstadoPedido.EnPreparacion;
                return;
            }

            Nav.NavigateTo("/pedidos");
        }
        catch (ApiException ex)
        {
            _error = $"No se pudo guardar el pedido: {ex.Message}";
        }
        catch (HttpRequestException)
        {
            _error = "No se pudo guardar el pedido: no se pudo conectar con el servidor.";
        }
    }

    // A diferencia de "En Preparación", pasar a Servido no factura nada ni pide datos
    // adicionales: es un PUT comun via IEntityApiClient<T>, sin query params.
    private async Task HandleMarcarServido()
    {
        if (Id is null) return;

        var actualizado = new Pedido
        {
            Id = _entity.Id,
            Comensal = _entity.Comensal,
            Estado = EstadoPedido.Servido,
            Tipo = _entity.Tipo,
            IdMesero = _entity.IdMesero,
            DireccionEntrega = _entity.DireccionEntrega,
            UbicacionCompartida = _entity.UbicacionCompartida,
            LatitudEntrega = _entity.LatitudEntrega,
            LongitudEntrega = _entity.LongitudEntrega,
        };

        try
        {
            await Api.UpdateAsync(actualizado);
            Nav.NavigateTo("/pedidos");
        }
        catch (ApiException ex)
        {
            _error = $"No se pudo marcar el pedido como servido: {ex.Message}";
        }
        catch (HttpRequestException)
        {
            _error = "No se pudo marcar el pedido como servido: no se pudo conectar con el servidor.";
        }
    }

    // Unico PUT de esta pagina que necesita mandar el metodo de pago (PedidosController.Update
    // factura automaticamente al pasar a EnPreparacion). IEntityApiClient<T> es generico y no
    // soporta query params (lo usan 8+ paginas mas sin tocar); en vez de estirarlo, se arma un
    // HttpClient crudo, igual que /auth/login en Program.cs.
    private Task ActualizarPedidoConMetodoPagoAsync(Pedido pedido, MetodoPago metodoPago)
    {
        // Este PUT no pasa por IEntityApiClient<T>, asi que tampoco por su decorador: hay
        // que reportar el progreso a mano. Es la unica llamada de la aplicacion en esa
        // situacion, y encima es de las lentas (factura y crea la cuenta).
        return EstadoOperaciones.SeguirAsync(async () =>
        {
            var http = HttpClientFactory.CreateClient("AtipicoApi");
            var url = $"{ApiRoutes.For<Pedido>()}/{pedido.Id}?metodoPago={Uri.EscapeDataString(metodoPago.ToString())}";

            var response = await http.PutAsJsonAsync(url, pedido, JsonOptions);
            if (!response.IsSuccessStatusCode)
                throw new ApiException(await LeerMensajeErrorAsync(response));
        });
    }

    // Copiado de EntityApiClient<TEntity> (es privado ahi): mismo contrato { "message": "..." }
    // que arma EntityControllerBase.TryTranslateDbError.
    private static async Task<string> LeerMensajeErrorAsync(HttpResponseMessage response)
    {
        try
        {
            var texto = await response.Content.ReadAsStringAsync();
            if (!string.IsNullOrWhiteSpace(texto))
            {
                using var doc = JsonDocument.Parse(texto);
                if (doc.RootElement.TryGetProperty("message", out var mensaje) && mensaje.ValueKind == JsonValueKind.String)
                    return mensaje.GetString()!;
            }
        }
        catch (JsonException)
        {
        }

        return response.StatusCode switch
        {
            HttpStatusCode.Forbidden => "No tenés permisos para realizar esta acción.",
            HttpStatusCode.NotFound => "El registro no existe o ya fue eliminado.",
            HttpStatusCode.BadRequest => "Los datos enviados no son válidos.",
            HttpStatusCode.Conflict => "La operación no se puede completar por un conflicto con datos existentes.",
            _ => $"Error inesperado del servidor ({(int)response.StatusCode}).",
        };
    }

    // No hay borrado real (app_restaurante no tiene GRANT DELETE): "Anular" pone
    // Estado=Anulado. PedidosController.Update ya libera la mesa asociada en esa transición.
    // Los platos pendientes (sin guardar) se descartan: nunca llegaron a la base.
    private async Task HandleAnularPedido()
    {
        if (Id is null) return;

        var confirmado = await JS.InvokeAsync<bool>("confirm", $"¿Anular el {Titulo.ToLowerInvariant()}?");
        if (!confirmado) return;

        var actualizado = new Pedido
        {
            Id = _entity.Id,
            Comensal = _entity.Comensal,
            Estado = EstadoPedido.Anulado,
            Tipo = _entity.Tipo,
            IdMesero = _entity.IdMesero,
            DireccionEntrega = _entity.DireccionEntrega,
            UbicacionCompartida = _entity.UbicacionCompartida,
            LatitudEntrega = _entity.LatitudEntrega,
            LongitudEntrega = _entity.LongitudEntrega,
        };

        try
        {
            await Api.UpdateAsync(actualizado);
            Nav.NavigateTo("/pedidos");
        }
        catch (ApiException ex)
        {
            _error = $"No se pudo anular el pedido: {ex.Message}";
        }
        catch (HttpRequestException)
        {
            _error = "No se pudo anular el pedido: no se pudo conectar con el servidor.";
        }
    }

    // Los platos agregados quedan solo en memoria hasta que se presiona "Cerrar pedido":
    // recien ahi se crean en la base, uno por uno, antes de mandar el pedido a cocina.
    private async Task<bool> GuardarPlatosPendientesAsync()
    {
        if (Id is null) return true;

        foreach (var idPlato in _platosPendientes.ToList())
        {
            try
            {
                await PedidoPlatoApi.CreateAsync(new PedidoPlato { IdPedido = Id.Value, IdPlato = idPlato });
                _platosPendientes.Remove(idPlato);
            }
            catch (ApiException ex)
            {
                _error = $"No se pudo guardar un plato: {ex.Message}";
                return false;
            }
            catch (HttpRequestException)
            {
                _error = "No se pudo guardar un plato: no se pudo conectar con el servidor.";
                return false;
            }
        }

        await LoadAsociaciones();
        return true;
    }

    private void HandleAddPlato()
    {
        if (Id is null || _selectedPlatoId == 0) return;

        _platosPendientes.Add(_selectedPlatoId);
    }

    private void HandleQuitarPendiente(int index)
    {
        if (index < 0 || index >= _platosPendientes.Count) return;

        _platosPendientes.RemoveAt(index);
    }

    // app_restaurante no tiene GRANT DELETE (sql/script_inicial.sql): los pedido_plato se
    // anulan, no se borran. fn_pedido_plato_facturado (trigger) rechaza anular un plato que ya
    // tiene un DetalleCuenta, y ck_pedido_plato_anulacion exige responsable y motivo.
    private async Task HandleRemovePlato(long pedidoPlatoId)
    {
        var pp = _pedidoPlatos.FirstOrDefault(x => x.Id == pedidoPlatoId);
        if (pp is null) return;

        var motivo = await JS.InvokeAsync<string?>("prompt", "Motivo para quitar el plato:");
        if (string.IsNullOrWhiteSpace(motivo)) return;

        try
        {
            var anulado = new PedidoPlato
            {
                Id = pp.Id,
                IdPedido = pp.IdPedido,
                IdPlato = pp.IdPlato,
                Estado = EstadoPedidoPlato.Anulado,
                IdAnuladoPor = await CurrentUsuarioIdAsync(),
                MotivoAnulacion = motivo,
            };

            await PedidoPlatoApi.UpdateAsync(anulado);
            await LoadAsociaciones();
        }
        catch (ApiException ex)
        {
            _error = $"Error al quitar el plato: {ex.Message}";
        }
        catch (HttpRequestException)
        {
            _error = "Error al quitar el plato: no se pudo conectar con el servidor.";
        }
    }

    // A diferencia de los platos, asociar una mesa es inmediato (no se agenda para "En
    // Preparación"): PedidoMesasController.Create ya marca la mesa como Ocupada al crear la
    // fila, y ocupar una mesa esta ligado a sentar a los comensales, no al timing de cocina.
    private async Task HandleAddMesa()
    {
        if (Id is null || _selectedMesaId == 0) return;

        try
        {
            await PedidoMesaApi.CreateAsync(new PedidoMesa { IdPedido = Id.Value, IdMesa = _selectedMesaId });
            await LoadAsociaciones();
            _selectedMesaId = _mesaPorDefecto;
        }
        catch (ApiException ex)
        {
            _error = $"No se pudo asociar la mesa: {ex.Message}";
        }
        catch (HttpRequestException)
        {
            _error = "No se pudo asociar la mesa: no se pudo conectar con el servidor.";
        }
    }

    // app_restaurante no tiene GRANT DELETE (sql/script_inicial.sql) y pedido_mesa no tiene
    // Estado para anular en su lugar: esto siempre va a devolver 409 "no se eliminan, se
    // anulan". Se deja el boton por simetria con platos, mostrando el error en vez de romper
    // la pantalla.
    private async Task HandleRemoveMesa(long pedidoMesaId)
    {
        try
        {
            await PedidoMesaApi.DeleteAsync(pedidoMesaId);
            await LoadAsociaciones();
        }
        catch (ApiException ex)
        {
            _error = $"Error al quitar la mesa: {ex.Message}";
        }
        catch (HttpRequestException)
        {
            _error = "Error al quitar la mesa: no se pudo conectar con el servidor.";
        }
    }
}
