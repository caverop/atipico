@page "/pedido-platos"
@attribute [Authorize]
@inject IEntityApiClient<PedidoPlato> Api
@inject IEntityApiClient<Pedido> PedidoApi
@inject IEntityApiClient<Plato> PlatoApi
@inject IJSRuntime JS

<PageTitle>Pedido &lt;-&gt; Plato</PageTitle>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}

<EntityTable TEntity="PedidoPlato"
             Title="Platos por pedido"
             Items="_items"
             Columns="_columns"
             CreateUrl="/pedido-platos/nuevo"
             EditUrlPrefix="/pedido-platos"
             OnDelete="HandleDelete"
             DeleteLabel="Anular"
             WriteRoles="@(["Admin", "Mesero", "Cocinero"])" />

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private string? _error;
    private List<PedidoPlato>? _items;
    private Dictionary<long, string> _pedidoLabels = [];
    private Dictionary<long, string> _platoLabels = [];
    private List<(string Header, Func<PedidoPlato, object?> Value)> _columns = [];

    protected override async Task OnInitializedAsync()
    {
        var pedidos = await PedidoApi.GetAllAsync();
        _pedidoLabels = pedidos.ToDictionary(p => p.Id, p => $"#{p.Id} - {p.Comensal ?? "sin nombre"}");

        var platos = await PlatoApi.GetAllAsync();
        _platoLabels = platos.ToDictionary(p => p.Id, p => p.Nombre);

        _columns =
        [
            ("Id", pp => pp.Id),
            ("Pedido", pp => _pedidoLabels.GetValueOrDefault(pp.IdPedido, $"#{pp.IdPedido}")),
            ("Plato", pp => _platoLabels.GetValueOrDefault(pp.IdPlato, $"#{pp.IdPlato}")),
            ("Estado", pp => pp.Estado),
        ];

        _items = await Api.GetAllAsync();
    }

    // No hay borrado real (app_restaurante no tiene GRANT DELETE): "Anular" pone
    // Estado=Anulado. fn_pedido_plato_facturado (trigger) rechaza anular un plato que ya
    // tiene un DetalleCuenta, y ck_pedido_plato_anulacion exige responsable y motivo.
    private async Task HandleDelete(long id)
    {
        var pp = _items?.FirstOrDefault(x => x.Id == id);
        if (pp is null) return;

        var motivo = await JS.InvokeAsync<string?>("prompt", "Motivo para anular el plato:");
        if (string.IsNullOrWhiteSpace(motivo)) return;

        try
        {
            pp.Estado = EstadoPedidoPlato.Anulado;
            pp.IdAnuladoPor = await CurrentUsuarioIdAsync();
            pp.MotivoAnulacion = motivo;

            await Api.UpdateAsync(pp);
            _items = await Api.GetAllAsync();
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        catch (HttpRequestException)
        {
            _error = "No se pudo conectar con el servidor.";
        }
    }

    private async Task<long?> CurrentUsuarioIdAsync()
    {
        if (AuthStateTask is null) return null;

        var authState = await AuthStateTask;
        var claim = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        return long.TryParse(claim, out var id) ? id : null;
    }
}
