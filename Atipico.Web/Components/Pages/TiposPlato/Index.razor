@page "/tipos-plato"
@attribute [Authorize]
@inject IEntityApiClient<TipoPlato> Api

<PageTitle>Tipos de plato</PageTitle>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}

<EntityTable TEntity="TipoPlato"
             Title="Tipos de plato"
             Items="_tipos"
             Columns="_columns"
             CreateUrl="/tipos-plato/nuevo"
             EditUrlPrefix="/tipos-plato"
             OnDelete="HandleDelete"
             WriteRoles="@(["Admin"])" />

@code {
    private string? _error;
    private List<TipoPlato>? _tipos;

    private readonly List<(string Header, Func<TipoPlato, object?> Value)> _columns =
    [
        ("Id", t => t.Id),
        ("Nombre", t => t.Nombre),
        ("Observación", t => t.Observacion),
    ];

    protected override async Task OnInitializedAsync()
    {
        _tipos = await Api.GetAllAsync();
    }

    private async Task HandleDelete(long id)
    {
        try
        {
            await Api.DeleteAsync(id);
            _tipos = await Api.GetAllAsync();
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        catch (HttpRequestException)
        {
            _error = "No se pudo conectar con el servidor.";
        }
    }
}
