# Copia este archivo a .env (que ya esta en .gitignore, nunca se commitea) y
# completa los valores reales antes de correr docker compose up.

DB_CONNECTION_STRING=Host=...;Port=5432;Database=...;Username=...;Password=...;SSL Mode=Require;Channel Binding=Require
JWT_KEY=...
JWT_ISSUER=Atipico.Api
JWT_AUDIENCE=Atipico.Clients
JWT_EXPIRY_MINUTES=480

# Cloudflare R2 — comprobantes de pago QR (ver specs/comprobantes-qr.md).
# Este archivo SE COMMITEA: aca van placeholders, nunca valores reales.
# Los valores reales van en .env, que esta en .gitignore.
# El bucket de produccion es atipico-comprobantes.
R2__AccountId=...
R2__AccessKeyId=...
R2__SecretAccessKey=...
R2__Bucket=atipico-comprobantes-dev
